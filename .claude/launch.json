{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ads-admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@dotlife/ads-admin", "dev"],
      "port": 5190
    },
    {
      "name": "ads-admin-built",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dotlife/ads-admin",
        "exec",
        "vite",
        "preview",
        "--port",
        "5192",
        "--strictPort"
      ],
      "port": 5192
    },
    {
      "name": "newtab-with-ads",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_ADS_URL=http://localhost:5190",
        "pnpm",
        "--filter",
        "@dotlife/newtab",
        "dev"
      ],
      "port": 8098
    }
  ]
}
