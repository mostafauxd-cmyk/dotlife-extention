{
  "manifest_version": 3,
  "name": "نقطه",
  "short_name": "نقطه",
  "description": "نیوتب نقطه: سرچ گوگل، کارها و یادداشت‌های نقطه، و امروز، روی هر تب تازه.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "chrome_url_overrides": { "newtab": "index.html" },
  "permissions": ["storage", "unlimitedStorage", "search", "favicon", "bookmarks", "topSites"],
  "host_permissions": ["https://noghte.life/*"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
