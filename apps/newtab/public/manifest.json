{
  "manifest_version": 3,
  "name": "نقطه",
  "short_name": "نقطه",
  "description": "نیوتب نقطه: سرچ گوگل، کارها و یادداشت‌های نقطه، و امروز، روی هر تب تازه.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "123",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "search",
    "favicon",
    "bookmarks",
    "topSites",
    "identity",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://noghte.life/*",
    "https://suggestqueries.google.com/*",
    "https://www.googleapis.com/*",
    "https://meet.googleapis.com/*",
    "https://web.telegram.org/*",
    "https://*.instagram.com/*",
    "https://web.whatsapp.com/*",
    "https://x.com/*",
    "https://web.bale.ai/*",
    "https://web.rubika.ir/*",
    "https://web.eitaa.com/*",
    "https://api.paket.app/*",
    "https://raw.githubusercontent.com/iran-market/*",
    "https://api.nobitex.ir/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frames",
        "enabled": true,
        "path": "frames.json"
      }
    ]
  }
}
